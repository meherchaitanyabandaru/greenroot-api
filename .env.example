APP_NAME=greenroot-api
# Required: local | development | test | ci | staging | production. There is no
# default: a missing APP_ENV refuses to start (it used to mean "local" and the
# public dev JWT secret). staging and production run the production checks.
APP_ENV=local
APP_VERSION=0.1.0

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Load balancers / reverse proxies whose X-Forwarded-For is believed (CIDRs or IPs).
# Empty = use the TCP peer address. Behind a proxy, set it or every client shares one rate-limit bucket.
# Required in production (e.g. the Docker network of the Caddy proxy: 172.16.0.0/12).
TRUSTED_PROXIES=
# Session time zone for the business calendar (CURRENT_DATE, date-based codes). Timestamps are
# timestamptz, so stored instants never depend on it.
DB_TIMEZONE=Asia/Kolkata

LOG_DIR=logs
LOG_LEVEL=info
LOG_RETENTION_DAYS=90

DATABASE_URL=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
DB_CONNECT_TIMEOUT=5s

JWT_SECRET=local-dev-change-me
JWT_ISSUER=greenroot-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_SIGNING_METHOD=HS256
# HMAC key for the 4-digit delivery codes; required in production (32+ random
# bytes, different from JWT_SECRET). Locally it is derived from JWT_SECRET.
DELIVERY_CODE_SECRET=

# Razorpay Standard Checkout (subscription payments). Both set = real payments,
# owners must pay through Razorpay; either empty = mock payments (local dev).
# The secret stays on the API; the app gets only the key id per order.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret; events: payment.captured, order.paid, refund.processed, refund.failed.
# URL: https://<api>/api/v1/webhooks/razorpay. Required in production with keys.
RAZORPAY_WEBHOOK_SECRET=

# Push notifications: Firebase service-account JSON (one line). Required in
# production; empty = in-app inbox only.
FCM_SERVICE_ACCOUNT_JSON=

# Production: name or ARN of an AWS Secrets Manager secret holding a JSON object
# of these variables (JWT_SECRET, DATABASE_URL, RAZORPAY_*, ...). Read at start-up;
# a variable set in the environment wins. See greenroot-infra/deploy.
AWS_SECRETS_ID=

# Serve /swagger and /openapi.yaml (default: on locally, off in staging/production).
DOCS_ENABLED=

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Object storage. Local: MinIO defaults. AWS: endpoint s3.ap-south-1.amazonaws.com,
# STORAGE_USE_SSL=true, STORAGE_BUCKET_PREFIX=greenroot-prod-, STORAGE_PUBLIC_URL=https://files.<domain>
# (CloudFront), and STORAGE_USE_IAM_ROLE=true so the EC2 instance role is used (no keys).
STORAGE_ENDPOINT=localhost:9000
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_BUCKET_PREFIX=
STORAGE_USE_IAM_ROLE=false

# mock (local) | aws (AWS End User Messaging SMS, needs DLT) — credentials from the AWS chain.
SMS_PROVIDER=mock
# mock (local) | ses (Amazon SES) — credentials from the AWS chain.
EMAIL_PROVIDER=mock
AWS_REGION=ap-south-1
